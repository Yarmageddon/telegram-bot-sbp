# Скопируй этот файл в .env и заполни значения

# Обязательно
BOT_TOKEN=your_bot_token_here

# Через запятую, без пробелов
ADMIN_IDS=123456789,987654321

# SQLite по умолчанию, для продакшена используй PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./bot.db

# Реквизиты для оплаты (отображаются пользователям)
PAYMENT_CARD=2200 0000 0000 0000
PAYMENT_PHONE=+7 900 000-00-00
